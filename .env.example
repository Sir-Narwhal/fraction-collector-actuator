# Copy this file to .env and fill in real values for your deployment.
# .env is gitignored and must never be committed.

# Host/IP of the Redis instance used to coordinate with the BioSMB skid
REDIS_URL=localhost

# Full MongoDB connection string (credentials included) used to log fraction data
MONGO_URL=mongodb://<username>:<password>@<host>:<port>/

# Host/IP of the Modbus TCP PLC controlling the diverter valve and fraction collector
MODBUS_URL=localhost
